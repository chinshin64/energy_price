# MOBILE_SYNC_TOKEN is no longer required for local/intranet deployments
PORT=3000
MOBILE_INTENT_DCC_URL=
MOBILE_INTENT_DCC_COMMAND=./scripts/dcc-mobile-intent-agent.sh
MOBILE_INTENT_DCC_CWD=.
MOBILE_INTENT_DCC_TIMEOUT_MS=8000
CAPTURE_RECORDER_BIN=
CAPTURE_RECORDER_HOST=0.0.0.0
CAPTURE_RECORDER_PORT=8899

# OpenAI-compatible AI Agent for method2/method3 failure analysis
# mode: disabled | dry_run | enabled
AI_AGENT_MODE=disabled
AI_AGENT_TYPE=openai_compatible
AI_AGENT_BASE_URL=http://127.0.0.1:7001/v1
AI_AGENT_API_KEY=your_api_key_here
AI_AGENT_MODEL_ID=your_model_id_here
AI_AGENT_TIMEOUT_MS=60000
AI_AGENT_APPLY_LOW_RISK_PATCHES=false
AI_AGENT_SAVE_EVENTS=true
