PORT=3000

# Runtime evidence, report, capture and device state root. Keep each environment isolated.
DATA_ROOT=data
SIGNATURE_HEALTH_MONITOR_ENABLED=true

# SQLite runtime. Relative DATABASE_PATH values are resolved from the project root.
DATABASE_PATH=data/stations.db
DATABASE_BUSY_TIMEOUT_MS=5000
# Empty defaults to apply outside production and validate in production.
DATABASE_MIGRATION_MODE=
RAW_DATA_MAX_BYTES=524288
PRICE_SCHEDULE_RAW_DATA_MAX_BYTES=65536
EXPORT_MAX_ROWS=50000
SCHEDULE_TIMEZONE=Asia/Shanghai

# Encrypt credentials stored in app_settings. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
ALLOW_PLAINTEXT_SECRETS=false

# No proxy host is embedded in source. Configure an explicit deployment value when required.
UNIFIED_OUTBOUND_PROXY_URL=
ALLOW_DIRECT_OUTBOUND=0

# Browser-rendered mini-program signer. Missing Chrome or source files automatically fall back
# to the collectors' existing manual/VM/corpus signers.
BROWSER_SIGNER_ENABLED=true
BROWSER_SIGNER_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_SIGNER_SIGN_TIMEOUT_MS=5000
BROWSER_SIGNER_DIDI_MAIN_PATH=
BROWSER_SIGNER_DIDI_WSGSIG_PATH=
BROWSER_SIGNER_DIDI_BIZ_ID=f68afecafe0587d40fa615b896e9aa64
BROWSER_SIGNER_DIDI_APP_VERSION=6.10.59
BROWSER_SIGNER_DIDI_OS=1
BROWSER_SIGNER_TELD_PATH=
BROWSER_SIGNER_STARCHARGE_PATH=
BROWSER_SIGNER_KUAIDIAN_PATH=
BROWSER_SIGNER_TUANYOU_PATH=

# Backend-controlled Kuaidian request credentials. Device-related values must
# be explicit backend settings and may be empty only when approved.
KUAIDIAN_APP_KEY=
KUAIDIAN_APP_SECRET=
KUAIDIAN_APP_TERMINAL=
KUAIDIAN_APP_NAME=
KUAIDIAN_PLATFORM_TYPE=
KUAIDIAN_TERMINAL_TYPE=
KUAIDIAN_HOST=
KUAIDIAN_USER_AGENT=
KUAIDIAN_REFERER=
KUAIDIAN_TOKEN=
KUAIDIAN_SENSOR_ID=
KUAIDIAN_DEVICE_ID=
KUAIDIAN_SA_DISTINCT_ID=
KUAIDIAN_SA_ANONYMOUS_ID=

# Backend-controlled Tuanyou request credentials. Keep all values outside source
# control. TUANYOU_TOKEN and TUANYOU_FROM_SCAN_CODE must be explicitly present;
# they may be empty only when the approved backend configuration requires it.
TUANYOU_APP_KEY=
TUANYOU_APP_SECRET=
TUANYOU_HOST=
TUANYOU_USER_AGENT=
TUANYOU_REFERER=
TUANYOU_MP_VERSION=
TUANYOU_SHUMEI_ID=
TUANYOU_TOKEN=
TUANYOU_FROM_SCAN_CODE=
BROWSER_SIGNER_XDT_PATH=

# Human access control. Production refuses AUTH_MODE=disabled.
# Recommended internal deployment: trusted_proxy behind the existing SSO reverse proxy.
AUTH_MODE=disabled
AUTH_TRUSTED_PROXY_IPS=127.0.0.1
AUTH_USER_HEADER=x-auth-request-user
AUTH_EMAIL_HEADER=x-auth-request-email
AUTH_ROLES_HEADER=x-auth-request-roles
AUTH_SCOPES_HEADER=x-auth-request-scopes
AUTH_DEFAULT_ROLE=viewer
AUTH_ROLE_MAP_JSON={}
AUTH_REQUIRED_SCOPE=

# Direct OIDC/JWKS mode (alternative to trusted_proxy).
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URI=
AUTH_OIDC_ALGORITHMS=RS256
AUTH_ROLES_CLAIM=roles
AUTH_SCOPES_CLAIM=scope
AUTH_OIDC_ALLOW_HTTP=false

# Browser CORS is not an authentication boundary. Production defaults to same-origin only.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
JSON_BODY_LIMIT=2mb
LARGE_JSON_BODY_LIMIT=25mb
URLENCODED_BODY_LIMIT=1mb
REPORT_SCREENSHOT_MAX_BYTES=10485760
REPORT_TEXT_EVIDENCE_MAX_BYTES=1048576
RUNTIME_CAPTURE_MAX_BYTES=2097152

# Device channel uses an independent machine credential in production.
MOBILE_SYNC_AUTH_REQUIRED=false
MOBILE_SYNC_TOKEN=
EDGE_AGENT_ENROLLMENT_TOKEN=
EDGE_AGENT_ONLINE_TTL_MS=45000
EDGE_TASK_LEASE_MS=120000
EDGE_GEO_RULES_PATH=./config/edge-geo-rules.json
EDGE_GEO_PROVIDER_URL=
# Comma-separated IP/CIDR entries for reverse proxies directly in front of this service.
EDGE_TRUST_PROXY_IPS=
SYNC_EVIDENCE_MAX_BYTES=10485760

# 47 MySQL mobile OCR source node. Use a dedicated least-privilege MySQL account.
# These values belong on 47 only; never commit real credentials.
MOBILE_SOURCE_HOST=0.0.0.0
MOBILE_SOURCE_PORT=50080
MOBILE_SOURCE_BODY_LIMIT=8mb
MOBILE_SOURCE_STATION_RAW_MAX_BYTES=65536
MOBILE_SOURCE_INGEST_TOKEN=
MOBILE_SOURCE_SYNC_TOKEN=
MOBILE_SOURCE_MYSQL_HOST=127.0.0.1
MOBILE_SOURCE_MYSQL_PORT=3306
MOBILE_SOURCE_MYSQL_USER=
MOBILE_SOURCE_MYSQL_PASSWORD=
MOBILE_SOURCE_MYSQL_DATABASE=
MOBILE_SOURCE_MYSQL_POOL_SIZE=10
MOBILE_SOURCE_TRUST_PROXY=

# Put these DDL credentials in .env.mobile-source-migration (mode 600), not
# in the runtime service environment. Keep the migration user isolated by
# default and disable it after deployment when a dedicated account is used.
MOBILE_SOURCE_MIGRATION_MYSQL_HOST=127.0.0.1
MOBILE_SOURCE_MIGRATION_MYSQL_PORT=3306
MOBILE_SOURCE_MIGRATION_MYSQL_USER=
MOBILE_SOURCE_MIGRATION_MYSQL_PASSWORD=
MOBILE_SOURCE_MIGRATION_MYSQL_DATABASE=
# Exceptional existing deployments may use the same non-root database owner
# only when both account and database match. Never put this key in runtime env.
MOBILE_SOURCE_ALLOW_SHARED_DB_OWNER_MIGRATION=false

# Local product: pull committed records from the 47 source node.
MOBILE_SOURCE_SYNC_ENABLED=false
MOBILE_SOURCE_BASE_URL=https://47.111.139.230
MOBILE_SOURCE_ALLOWED_HOSTS=47.111.139.230
MOBILE_SOURCE_ALLOW_HTTP=false
MOBILE_SOURCE_SYNC_BATCH_SIZE=200
MOBILE_SOURCE_SYNC_INTERVAL_MS=60000
MOBILE_SOURCE_SYNC_TIMEOUT_MS=15000
MOBILE_SOURCE_SYNC_INCLUDE_VERIFICATION_AGENT=false
MOBILE_SOURCE_SYNC_STATE_PATH=data/mobile-source-sync-state.json

# Evidence synchronization. Production requires SYNC_AUTH_TOKEN and an explicit host allowlist.
SYNC_AUTH_REQUIRED=false
SYNC_AUTH_TOKEN=
SYNC_ALLOWED_HOSTS=127.0.0.1,localhost
SYNC_LOCAL_NODE_URL=http://127.0.0.1:3000
SYNC_DEFAULT_NODE_NAME=
SYNC_DEFAULT_NODE_URL=

# Mobile sync currently relies on the internal network boundary. Commercial deployment must
# migrate this channel to device credentials before enabling it outside the trusted network.
MOBILE_INTENT_DCC_URL=
MOBILE_INTENT_DCC_COMMAND=./scripts/dcc-mobile-intent-agent.sh
MOBILE_INTENT_DCC_CWD=.
MOBILE_INTENT_DCC_TIMEOUT_MS=8000
CAPTURE_RECORDER_BIN=
CAPTURE_RECORDER_HOST=0.0.0.0
CAPTURE_RECORDER_PORT=8899

# OpenAI-compatible AI Agent for method2/method3 failure analysis
# mode: disabled | dry_run | enabled
AI_AGENT_MODE=disabled
AI_AGENT_TYPE=openai_compatible
AI_AGENT_BASE_URL=http://127.0.0.1:7001/v1
AI_AGENT_API_KEY=your_api_key_here
AI_AGENT_MODEL_ID=your_model_id_here
AI_AGENT_TIMEOUT_MS=60000
AI_AGENT_APPLY_LOW_RISK_PATCHES=false
AI_AGENT_SAVE_EVENTS=true

# 新电途(xdt) 充电站采集器凭证 (来自 /public/openapi/v0.1/user 匿名密钥交换响应)
# 凭证可能过期: 接口返回 code!=10000 时需重新抓包获取新 dk/pw/userName
XDT_PW=
XDT_DK=
XDT_USER_ID=
XDT_USER_NAME=
