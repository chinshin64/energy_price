# Main Blue Team server. The desktop Agent appends /api/edge paths automatically.
EDGE_SERVER_URL=http://server-host:50080
EDGE_ENROLLMENT_TOKEN=replace-with-server-enrollment-token

# Optional fixed node and parent controller identifiers.
EDGE_NODE_ID=
EDGE_PARENT_NODE_ID=

# Keep false for normal workers. Controllers may delegate only explicit scopes.
EDGE_CAN_DELEGATE=false
EDGE_DELEGATED_CAPABILITIES=
EDGE_DELEGATED_REGIONS_JSON=[]

# A desktop Agent can invoke only allowlisted APIs on a loopback Blue Team service.
EDGE_LOCAL_BLUE_TEAM_URL=http://127.0.0.1:50080
EDGE_LOCAL_BLUE_TEAM_TOKEN=
EDGE_POLL_INTERVAL_MS=2000
EDGE_HEARTBEAT_INTERVAL_MS=15000
